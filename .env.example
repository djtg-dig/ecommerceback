# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Carri Account OIDC
CARRI_ACCOUNT_ISSUER=
CARRI_ACCOUNT_CLIENT_ID=
CARRI_ACCOUNT_CLIENT_SECRET=
CARRI_ACCOUNT_REDIRECT_URI=
CARRI_ACCOUNT_SCOPES=openid email
# Fixed Next.js receiver for the browser POST handoff delivery. HTTPS is
# required outside DEBUG; never put a user-supplied URL here.
CARRI_ACCOUNT_WEB_HANDOFF_DELIVERY_URL=
CARRI_ACCOUNT_ANDROID_CLIENT_ID=
CARRI_ACCOUNT_ANDROID_REDIRECT_URI=
CARRI_ACCOUNT_DISCOVERY_CACHE_SECONDS=300
CARRI_ACCOUNT_JWKS_CACHE_SECONDS=300
CARRI_ACCOUNT_ID_TOKEN_CLOCK_SKEW_SECONDS=60
CARRI_ACCOUNT_EMAIL_PROOF_MAX_AGE_SECONDS=600
CARRI_ACCOUNT_HANDOFF_TTL_SECONDS=120

# Business member invitations
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=
BUSINESS_MEMBER_INVITATION_URL=
BUSINESS_MEMBER_INVITATION_EXPIRY_HOURS=168

# Application-level HMAC client authentication
# Secrets live only here, never in the database or the repository.
# DISABLED = no verification, OBSERVATION = measure without blocking, ENFORCE = reject.
ECOMMERCE_HMAC_MODE=DISABLED
ECOMMERCE_HMAC_CLIENT_SECRETS=
ECOMMERCE_HMAC_MAX_CLOCK_SKEW_SECONDS=120
ECOMMERCE_HMAC_NONCE_TTL_SECONDS=900
ECOMMERCE_HMAC_MAX_BODY_BYTES=1000000
ECOMMERCE_HMAC_REQUIRE_BODY_HASH=true
# Only this BFF-only operation may be enabled. Do not add mobile/shared routes.
ECOMMERCE_HMAC_PROTECTED_PREFIXES=/api/v1/auth/carri/handoff/consume/
ECOMMERCE_HMAC_EXEMPT_METHODS=OPTIONS
